{
  "name": "si4care",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node --env-file=.env.local node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/.bin/drizzle-kit migrate",
    "db:push": "node --env-file=.env.local node_modules/.bin/drizzle-kit push",
    "db:studio": "node --env-file=.env.local node_modules/.bin/drizzle-kit studio",
    "db:seed": "node --env-file=.env.local node_modules/.bin/tsx src/lib/db/seed.ts",
    "db:seed:demo": "node --env-file=.env.local node_modules/.bin/tsx src/lib/db/seed-demo.ts",
    "test:reports": "node --env-file=.env.local node_modules/.bin/tsx scripts/test-reports.ts",
    "test:reports:clean": "node --env-file=.env.local node_modules/.bin/tsx scripts/test-reports.ts --clean",
    "db:backup": "bash scripts/db-backup.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file=.env.local node_modules/.bin/playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@base-ui/react": "^1.5.0",
    "@types/midtrans-client": "^1.4.0",
    "@upstash/redis": "^1.38.0",
    "better-auth": "^1.6.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.40.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.17.0",
    "midtrans-client": "^1.4.3",
    "mysql2": "^3.22.5",
    "next": "16.2.7",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
