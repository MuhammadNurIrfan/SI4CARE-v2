# Salin ke .env.local lalu isi nilainya. JANGAN commit .env.local.
# File ini sengaja hanya memuat nama variabel — tidak boleh ada nilai rahasia.

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Jangan pakai direct connection: free tier Supabase hanya IPv6.
#   Lokal / migrasi / seed : Session pooler   (port 5432) — mendukung semua fitur, tapi hanya 15 klien.
#   Production (Vercel)    : Transaction pooler (port 6543) — WAJIB. Serverless membuka koneksi per instance;
#                            mode session kehabisan klien (EMAXCONNSESSION) dengan sedikit trafik.
# Settings > Database > Connection string > pilih mode lalu salin.
# Contoh transaction pooler: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Opsional: batas koneksi per proses (default 5 di dev, 3 di production).
DATABASE_POOL_MAX=

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Produksi: domain publik, bukan localhost — kalau salah, redirect auth rusak.
BETTER_AUTH_URL=
# Domain publik situs, dipakai untuk URL kanonik / OpenGraph / JSON-LD artikel.
# Biasanya sama dengan BETTER_AUTH_URL. Tanpa ini SEO memakai domain bawaan di kode.
NEXT_PUBLIC_SITE_URL=

# ── Password akun seed & E2E ──────────────────────────────────────────────────
# Dipakai `db:seed`, `db:seed:demo`, dan spec Playwright. Wajib diisi — seeder
# berhenti dengan pesan jelas kalau kosong. Jangan pernah ditulis di repo.
SEED_ADMIN_PASSWORD=
SEED_SUPERADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# ── Google OAuth (opsional) ───────────────────────────────────────────────────
# Tombol login Google baru aktif setelah diisi.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cache & rate limit (Upstash Redis) ────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Pembayaran (Midtrans) ─────────────────────────────────────────────────────
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ── Ongkir (Komerce / RajaOngkir) ─────────────────────────────────────────────
KOMERCE_API_KEY=
# Asal pengiriman. API Komerce memakai ID wilayah numerik (bukan nama kota).
# KOMERCE_STORE_ORIGIN_ID (angka) diutamakan karena presisi; cari ID-nya dengan:
#   GET https://rajaongkir.komerce.id/api/v1/destination/domestic-destination?search=<kode pos / kelurahan>
# Jika hanya KOMERCE_STORE_ORIGIN (nama kota / kode pos) yang diisi, dipakai kelurahan pertama
# hasil pencarian — cukup untuk demo, kurang presisi untuk tarif nyata.
KOMERCE_STORE_ORIGIN_ID=
KOMERCE_STORE_ORIGIN=

# ── Penyimpanan foto (Cloudflare R2) ──────────────────────────────────────────
# Wajib sebelum deploy: public/uploads/ tidak bisa ditulis di Vercel.
# R2_PUBLIC_URL dipakai next.config.ts untuk images.remotePatterns — tanpa itu
# next/image menolak semua gambar remote di production.
# Nama kanonik: R2_ACCESS_KEY / R2_SECRET_KEY (nama gaya AWS R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY juga diterima).
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
